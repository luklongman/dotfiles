[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Longman
	email = 75369385+luklongman@users.noreply.github.com
[lfs]
	concurrenttransfers = 10
[core]
	excludesfile = $HOME/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	keep-plus-minus-markers = true
	navigate = true
[merge]
	tool = delta
	conflictstyle = diff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
