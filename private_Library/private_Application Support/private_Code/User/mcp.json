{
	"servers": {
		"mui-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@mui/mcp@latest"
			]
		},
		"context7": {
			"command": "npx",
			"args": [
				"-y",
				"@upstash/context7-mcp@latest"
			],
			"type": "stdio"
		},
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"type": "stdio"
		},
		"qdrant": {
			"command": "uvx",
			"args": [
				"mcp-server-qdrant"
			],
			"env": {
				"QDRANT_URL": "${input:qdrantUrl}",
				"QDRANT_API_KEY": "${input:qdrantApiKey}",
				"COLLECTION_NAME": "${input:collectionName}"
			},
			"type": "stdio"
		},
		"netlify": {
			"command": "npx",
			"args": [
				"-y",
				"@netlify/mcp"
			],
			"type": "stdio"
		},
		"npx -y @sveltejs/mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@sveltejs/mcp"
			]
		},
		"io.github.upstash/context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@upstash/context7-mcp@1.0.31"
			],
			"env": {
				"CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.31"
		},
		"dev.svelte/mcp": {
			"type": "http",
			"url": "https://mcp.svelte.dev/mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "0.1.26"
		},
		"console-ninja": {
			"command": "npx",
			"args": [
				"-y",
				"-c",
				"node ~/.console-ninja/mcp/"
			],
			"type": "stdio"
		}
	},
	"inputs": [
		{
			"type": "promptString",
			"id": "qdrantUrl",
			"description": "Qdrant URL"
		},
		{
			"type": "promptString",
			"id": "qdrantApiKey",
			"description": "Qdrant API Key",
			"password": true
		},
		{
			"type": "promptString",
			"id": "collectionName",
			"description": "Collection Name"
		},
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "API key for authentication",
			"password": true
		}
	]
}