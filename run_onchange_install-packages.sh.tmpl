#!/bin/bash
# Brewfile hash tracking: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}

echo "Installing selected Homebrew packages..."

# Create a temporary file for the generated Brewfile
BREWFILE_TMP="$(mktemp)"

# Write the template-rendered packages into the temp file (without deprecated taps)
cat << EOF > "$BREWFILE_TMP"
{{ range .selectedPackages -}}
{{ . }}
{{ end -}}
EOF

# Run brew bundle attached to the terminal for real-time progress display
brew bundle --file="$BREWFILE_TMP" </dev/tty >/dev/tty 2>&1

# Clean up the temporary file
rm -f "$BREWFILE_TMP"

echo "Installation complete!"