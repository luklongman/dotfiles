# Dump Homebrew packages directly into your Chezmoi source repository
function brew-dump() {
    local brewfile_path="$(chezmoi source-path)/dot_config/homebrew/Brewfile"
    
    # Ensure the directory exists in the source tree
    mkdir -p "$(dirname "$brewfile_path")"
    
    # Dump the packages
    brew bundle dump --file="$brewfile_path" --force
    echo "📦 Brewfile updated directly in Chezmoi source tree!"
}

